@Metadata.layer: #CORE
@UI: {
  headerInfo: { 
    typeName: 'Inventory Item',
    typeNamePlural: 'Inventory Items',
    title: { type: #STANDARD, value: 'ProductUUID' } 
  } 
}
annotate view ZC_INVENTORY_G04 with
{
  @UI.facet: [ {
    label: 'General Information', 
    id: 'GeneralInfo', 
    purpose: #STANDARD, 
    position: 10 , 
    type: #IDENTIFICATION_REFERENCE
  } ]

  @UI.hidden: true
  InventoryUuid;
  
  @EndUserText.label: 'Product'
  @UI.selectionField: [{ position: 10 }]
  @UI.lineItem: [{ position: 10, label: 'Product' }]
  @UI.identification: [{ position: 10, label: 'Product' }]
  ProductUuid;
  
  @EndUserText.label: 'Warehouse'
  @UI.selectionField: [{ position: 20 }]
  @UI.lineItem: [{ position: 20, label: 'Warehouse' }]
  @UI.identification: [{ position: 20, label: 'Warehouse' }]
  WarehouseUuid;
  
  @EndUserText.label: 'Quantity'
  @UI.selectionField: [{ position: 30 }]
  @UI.lineItem: [{ position: 30, label: 'Quantity' }]
  @UI.identification: [{ position: 30, label: 'Quantity' }]
  Quantity;
  
  @EndUserText.label: 'Unit'
  @UI.selectionField: [{ position: 35 }]
  @UI.lineItem: [{ position: 35, label: 'Unit' }]
  @UI.identification: [{ position: 35, label: 'Unit' }]
  UnitOfMeasure;
  
  @EndUserText.label: 'Restock Date'
  @UI.selectionField: [{ position: 40 }]
  @UI.lineItem: [{ position: 40, label: 'Restock Date' }]
  @UI.identification: [{ position: 40, label: 'Restock Date' }]
  LastRestockDate;
  
  @UI.hidden: true
  LocalCreatedBy;
  
  @UI.hidden: true
  LocalCreatedAt;
  
  @UI.hidden: true
  LocalLastChangedBy;
  
  @UI.hidden: true
  LocalLastChangedAt;
  
  @UI.hidden: true
  LastChangedAt;
}