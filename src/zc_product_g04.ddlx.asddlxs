@Metadata.layer: #CORE
@UI: {
  headerInfo: { 
    typeName: 'Product',
    typeNamePlural: 'Products',
    title: { type: #STANDARD, value: 'Name' },
    description: { type: #STANDARD, value: 'ProductId' } 
  } 
}
annotate view ZC_PRODUCT_G04 with
{
  @UI.facet: [ {
    label: 'Product Details', 
    id: 'ProductInfo', 
    purpose: #STANDARD, 
    position: 10 , 
    type: #IDENTIFICATION_REFERENCE
  } ]

  /* Hide the main Product UUID */
  @UI.hidden: true
  ProductUUID;
  
  @EndUserText.label: 'Product ID'
  @UI.selectionField: [{ position: 10 }]
  @UI.lineItem: [{ position: 10, label: 'Product ID' }]
  @UI.identification: [{ position: 10, label: 'Product ID' }]
  ProductID;
  
  @EndUserText.label: 'Product Name'
  @UI.selectionField: [{ position: 20 }]
  @UI.lineItem: [{ position: 20, label: 'Product Name' }]
  @UI.identification: [{ position: 20, label: 'Product Name' }]
  Name;

  /* Hide Category and Supplier UUIDs */
  @UI.hidden: true
  CategoryUUID;
  
  @UI.hidden: true
  SupplierUUID;
  
  @UI.lineItem: [{ position: 30, label: 'Price' }]
  @UI.identification: [{ position: 30, label: 'Price' }]
  Price;
  
  @UI.lineItem: [{ position: 35, label: 'Currency' }]
  @UI.identification: [{ position: 35, label: 'Currency' }]
  Currency;
  
  /* Hide all administrative fields */
  @UI.hidden: true
  LocalCreatedBy;
  
  @UI.hidden: true
  LocalCreatedAt;
  
  @UI.hidden: true
  LocalLastChangedBy;
  
  @UI.hidden: true
  LocalLastChangedAt;
  
  @UI.hidden: true
  LastChangedAt;
}