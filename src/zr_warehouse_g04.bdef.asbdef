managed implementation in class ZBP_R_WAREHOUSE_G04 unique;
strict ( 2 );
with draft;
extensible;
define behavior for ZR_WAREHOUSE_G04 alias ZrWarehouseG04
persistent table zwarehouse_g04
extensible
draft table zwarehouse_g04_d
etag master LocalLastChangedAt
lock master total etag LastChangedAt
authorization master ( global )
{
  field ( readonly )
  WarehouseUUID,
  LocalCreatedBy,
  LocalCreatedAt,
  LocalLastChangedBy,
  LocalLastChangedAt,
  LastChangedAt;

  field ( numbering : managed )
  WarehouseUUID;

  create;
  update;
  delete;

  validation validateCapacity on save { create; update; }

  draft action Activate optimized;
  draft action Discard;
  draft action Edit;
  draft action Resume;

  draft determine action Prepare
  {
    validation validateCapacity;
  }

  mapping for zwarehouse_g04 corresponding extensible
    {
      WarehouseUUID      = WAREHOUSE_UUID;
      WarehouseID        = WAREHOUSE_ID;
      Location           = LOCATION;
      Capacity           = CAPACITY;
      LocalCreatedBy     = LOCAL_CREATED_BY;
      LocalCreatedAt     = LOCAL_CREATED_AT;
      LocalLastChangedBy = LOCAL_LAST_CHANGED_BY;
      LocalLastChangedAt = LOCAL_LAST_CHANGED_AT;
      LastChangedAt      = LAST_CHANGED_AT;
    }
}