managed implementation in class ZBP_R_INVENTORY_G04 unique;
strict ( 2 );
with draft;
extensible;
define behavior for ZR_INVENTORY_G04 alias ZrInventoryG04
persistent table ZINVENTORY_G04
extensible
draft table ZINVENTORY_G04_D
etag master LocalLastChangedAt
lock master total etag LastChangedAt
authorization master( global )
{
  field ( readonly )
   InventoryUUID,
   LastRestockDate,
   LocalCreatedBy,
   LocalCreatedAt,
   LocalLastChangedBy,
   LocalLastChangedAt,
   LastChangedAt;

   /* Ensure users must select a Product and a Warehouse */
  field ( mandatory )
   ProductUUID,
   WarehouseUUID;

  field ( numbering : managed )
   InventoryUUID;


  create;
  update;
  delete;

  draft action Activate optimized;
  draft action Discard;
  draft action Edit;
  draft action Resume;
  draft determine action Prepare
  {
    validation validateQuantity;
    validation validateRestockDate;
  }

  /* Validations */
  validation validateQuantity on save { field Quantity; create; update; }
  validation validateRestockDate on save { field LastRestockDate; create; update; }

determination setInitialDate on modify { create; field Quantity; }

  mapping for ZINVENTORY_G04 corresponding extensible

  {
    InventoryUUID = INVENTORY_UUID;
    ProductUUID = PRODUCT_UUID;
    WarehouseUUID = WAREHOUSE_UUID;
    Quantity = QUANTITY;
    UnitOfMeasure = UNIT_OF_MEASURE;
    LastRestockDate = LAST_RESTOCK_DATE;
    LocalCreatedBy = LOCAL_CREATED_BY;
    LocalCreatedAt = LOCAL_CREATED_AT;
    LocalLastChangedBy = LOCAL_LAST_CHANGED_BY;
    LocalLastChangedAt = LOCAL_LAST_CHANGED_AT;
    LastChangedAt = LAST_CHANGED_AT;
  }

}